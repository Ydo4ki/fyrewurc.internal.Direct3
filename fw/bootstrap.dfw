// defined: K, S, type, EQ, Call, telephonize, _GenesisInstancer, _AllUnpacker

I = S(K, K)

T = K
F = S(K)

AND = S(S, K(K(F)))
OR = S(I, K(T))
NOT = S(S(I, K(F)), K(T))

PAIR = x -> y -> f -> f(x, y)
FIRST = p -> p(T)
SECOND = p -> p(F)

Telephonist = type(Call)
Instancer = type(_GenesisInstancer)


isTypeApiCall = arg -> t -> AND(EQ(type(arg), Call), EQ(type(arg.arg.val), t))

UnitCH = c -> EQ(c.arg,'cons')
    (c.instance(Telephonist))
    (c.val(c.arg))

Unit = telephonize(UnitCH)

unit = Unit.cons

mt = telephonize(I)
mtx = mt(K)

i1 = _GenesisInstancer(type)
